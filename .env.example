# OpenRouter credentials. Never commit the populated .env file.
OPENROUTER_API_KEY=
PATROLLENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers.
PATROLLENS_OPENROUTER_HTTP_REFERER=
PATROLLENS_OPENROUTER_TITLE=PatrolLens

# OpenRouter model slugs. The provider prefix is required.
PATROLLENS_GEMINI_MODEL=google/gemini-3.1-pro-preview
PATROLLENS_GEMINI_PLANNER_MODEL=google/gemini-3.1-pro-preview
PATROLLENS_EMBEDDING_MODEL=google/gemini-embedding-2
# Bulk transcript/image ingestion model; queries use PATROLLENS_EMBEDDING_QUERY_MODEL.
PATROLLENS_EMBEDDING_BATCH_MODEL=google/gemini-embedding-2:batch
# Used only when ingest is explicitly run with --embedding-mode batch.
PATROLLENS_EMBEDDING_BATCH_POLL_SECONDS=10
PATROLLENS_EMBEDDING_BATCH_TIMEOUT_SECONDS=86400
# Optional synchronous query override for retrieval.
PATROLLENS_EMBEDDING_QUERY_MODEL=google/gemini-embedding-2
PATROLLENS_EMBEDDING_DIMENSIONS=768

# Offline ingestion ASR through OpenRouter's transcription endpoint.
PATROLLENS_TRANSCRIBER=auto
PATROLLENS_ASR_MODEL=openai/whisper-large-v3-turbo
PATROLLENS_ASR_LANGUAGE=auto
PATROLLENS_ASR_CHUNK_SECONDS=300
PATROLLENS_ASR_TIMEOUT_SECONDS=90
PATROLLENS_ASR_MAX_RETRIES=3

# Standalone `patrol-lens compress` quality setting for the separate 480p corpus.
PATROLLENS_VIDEO_COMPRESSION_CRF=23

# Local Apple-Silicon CLAP audio retrieval. The setup script downloads the
# paired CoreML audio and ONNX text encoders into this ignored directory.
PATROLLENS_CLAP_MODEL=atan2f/larger_clap_general_coreml
PATROLLENS_CLAP_MODEL_ROOT=.patrol-lens-models/larger_clap_general_coreml
PATROLLENS_CLAP_COMPUTE_UNITS=cpu_only
PATROLLENS_CLAP_WINDOW_SECONDS=10
PATROLLENS_CLAP_STRIDE_SECONDS=5

# Optional production evidence/index backend. SQLite remains the default for
# local smoke tests; Postgres stores embeddings and provenance in one database.
PATROLLENS_STORE_BACKEND=postgres
PATROLLENS_DATABASE_URL=postgresql://patrol_lens:patrol_lens@localhost:5435/patrol_lens
PATROLLENS_ARTIFACT_ROOT=.patrol-lens

# Optional active-perception controls.
PATROLLENS_AGENT_MAX_TURNS=6
PATROLLENS_RUN_ROOT=.patrol-lens/runs
# Used as conservative accounting when a provider response omits actual cost.
PATROLLENS_ESTIMATED_MODEL_CALL_COST_USD=0.02

# Ingestion cost-report fallback assumptions; update these if provider pricing changes.
# Known Gemini rates are selected automatically from the active batch model.
PATROLLENS_ESTIMATED_ASR_USD_PER_HOUR=0.04
PATROLLENS_ESTIMATED_EMBEDDING_TEXT_USD_PER_MILLION_TOKENS=0.20
PATROLLENS_ESTIMATED_EMBEDDING_IMAGE_USD_PER_MILLION_TOKENS=0.45
# Model-specific overrides take precedence over the global fallback above.
PATROLLENS_ESTIMATED_EMBEDDING_TEXT_USD_PER_MILLION_TOKENS_GOOGLE_GEMINI_EMBEDDING_2_BATCH=0.10
PATROLLENS_ESTIMATED_EMBEDDING_IMAGE_USD_PER_MILLION_TOKENS_GOOGLE_GEMINI_EMBEDDING_2_BATCH=0.225
PATROLLENS_ESTIMATED_TRANSCRIPT_TOKENS_PER_MINUTE=240
PATROLLENS_ESTIMATED_IMAGE_TOKENS_PER_TILE=258
